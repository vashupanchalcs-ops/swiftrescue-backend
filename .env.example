# TomTom Routing API Key (Backend only, never committed to git)
TOMTOM_API_KEY=
# Server-only key for Google Routes API traffic-aware route calculations.
# Do not put this value in the React or Flutter Web builds.
GOOGLE_ROUTES_API_KEY=
# Optional Redis channel layer. Without this, Django uses in-memory Channels
# for local single-process development.
REDIS_URL=
TRACKING_LOCATION_CHECKPOINT_SECONDS=5
TRACKING_LOCATION_MAX_JUMP_METERS=2000
